{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "order-bridge",
  "version": "1.0.0",
  "description": "Minimalist, modular integration system built with Node.js, Express, and TypeScript, designed as an MVP for the central aggregation of orders from multiple sales channels.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomaszKlekner/order-bridge.git"
  },
  "keywords": [
    "Node",
    "Express",
    "Zod",
    "Integration"
  ],
  "author": "Tomasz Klekner",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/TomaszKlekner/order-bridge/issues"
  },
  "homepage": "https://github.com/TomaszKlekner/order-bridge#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "~5.8",
    "typescript-eslint": "^8.70.0"
  }
}
